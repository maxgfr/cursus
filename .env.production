# Content-Security-Policy of the built app (index.html %VITE_CSP%). Loopback http is allowed in
# connect-src for local S3 (MinIO) and local AI servers (Ollama, LM Studio) used from Chrome on the Mac.
VITE_CSP="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' https: wss: blob: data: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
